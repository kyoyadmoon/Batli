  "private": true,
  "type": "module",
  "description": "字學 Batli — 專為長者設計的識字學習 App",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "related-words:prepare": "node scripts/prepare-related-words-workflow.mjs",
    "related-words:apply": "node scripts/apply-related-words-workflow.mjs",
    "illustrations:generate": "node scripts/generate-vocab-illustrations.mjs",
    "illustrations:preview": "node scripts/generate-vocab-illustrations.mjs --prompts-only",
    "illustrations:status": "node scripts/generate-vocab-illustrations.mjs --dry-run"
  },
  "keywords": [],
  "author": "kyoyadmoon",
  "homepage": "https://kyoyadmoon.github.io/Batli/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kyoyadmoon/Batli.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@google/genai": "^1.46.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "jsdom": "^29.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "hanzi-writer": "^3.7.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  }
